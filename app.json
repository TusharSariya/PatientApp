{
  "expo": {
    "name": "PatientApp",
    "slug": "PatientApp",
    "version": "1.0.16",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow PatientApp to recognize your speech for dictation and visit narratives.",
        "NSMicrophoneUsageDescription": "Allow PatientApp to use your microphone for visit dictation."
      },
      "bundleIdentifier": "com.patientapp.patients"
    },
    "android": {
      "package": "com.patientapp.patients",
      "versionCode": 17,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withGemmaIosEntitlement",
      "./plugins/withXcode26ExplicitModulesFix",
      "expo-sqlite",
      "expo-audio",
      "react-native-litert-lm",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow PatientApp to use your microphone for visit dictation.",
          "speechRecognitionPermission": "Allow PatientApp to recognize your speech for dictation and visit narratives."
        }
      ],
      "@sentry/react-native",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "extra": {
      "gemmaIosExtendedAddressing": false,
      "eas": {
        "projectId": "2d24940f-1173-474f-bd3e-60f2df068342"
      }
    }
  }
}
