{
  "name": "patientapp",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "JAVA_HOME=$(/usr/libexec/java_home -v 21) expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "validate": "npm run check",
    "prepare": "husky",
    "lint": "expo lint",
    "doctor": "npx expo-doctor",
    "audit": "npm audit --audit-level=high",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "check": "npm test && npm run doctor && npm run lint"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.11",
    "@sentry/react-native": "~7.2.0",
    "expo": "~56.0.11",
    "expo-application": "~56.0.3",
    "expo-asset": "~56.0.17",
    "expo-audio": "~56.0.12",
    "expo-build-properties": "~56.0.18",
    "expo-constants": "~56.0.18",
    "expo-device": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-print": "~56.0.4",
    "expo-sensors": "~56.0.6",
    "expo-sharing": "~56.0.17",
    "expo-speech-recognition": "^56.0.1",
    "expo-sqlite": "~56.0.5",
    "expo-status-bar": "~56.0.4",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-litert-lm": "^0.4.2",
    "react-native-nitro-modules": "^0.35.9",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "private": true,
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~56.0.5",
    "lint-staged": "^17.0.7",
    "react-test-renderer": "^19.1.0",
    "typescript": "~5.9.2"
  },
  "lint-staged": {
    "src/**/*.js": [
      "eslint --fix"
    ],
    "__tests__/**/*.js": [
      "eslint --fix"
    ]
  }
}
